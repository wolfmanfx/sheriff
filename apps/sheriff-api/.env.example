# Sheriff API Environment Configuration

# Model Provider Type
# Options: 'lm-studio', 'openai', 'anthropic'
MODEL_PROVIDER=lm-studio

# LM Studio Configuration (when MODEL_PROVIDER=lm-studio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_CHAT_MODEL=gpt-4o

# Anthropic Configuration (when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenAI Configuration (when MODEL_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Server Configuration
HOST=localhost
PORT=3000
