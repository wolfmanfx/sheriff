{
  "name": "@softarc/sheriff",
  "version": "0.0.1",
  "description": "Modularity for TypeScript Projects",
  "license": "MIT",
  "scripts": {
    "build:all": "npx nx run-many --target=build && chmod +x dist/packages/core/src/bin/main.js",
    "commit": "commit",
    "lint:all": "eslint ./packages",
    "link:sheriff": "yarn run build:all && yalc publish dist/packages/core && yalc publish dist/packages/eslint-plugin && yalc link @softarc/sheriff-core @softarc/eslint-plugin-sheriff",
    "run:cli": "nx build core && chmod +x dist/packages/core/src/bin/main.js",
    "test": "vitest",
    "test:ci": "vitest -c vitest.config.ci.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "eval:dev": "npx evalite dev evals",
    "eval:run": "npx evalite run evals",
    "vscode:build": "nx build sheriff-ui --configuration=production && nx build-minimal sheriff-api --configuration=production && nx bundle-assets sheriff-vscode",
    "vscode:package": "yarn vscode:build && nx package sheriff-vscode",
    "vscode:publish": "yarn vscode:package && cd dist/apps/sheriff-vscode && npx @vscode/vsce publish"
  },
  "author": {
    "name": "Rainer Hahnekamp",
    "email": "rainer.hahnekamp@gmail.com"
  },
  "dependencies": {
    "codemirror": "^5.65.16",
    "@ai-sdk/angular": "2.0.0-beta.92",
    "@ai-sdk/anthropic": "^2.0.40",
    "@ai-sdk/google": "^2.0.26",
    "@ai-sdk/openai-compatible": "2.0.0-beta.31",
